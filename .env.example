# AAP MCP Server - Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# ─── Required ─────────────────────────────────────────────────────────────────
# AAP Controller URL (no trailing slash)
AAP_CONTROLLER_URL=https://your-aap-controller.example.com

# Authentication - use OAuth token (preferred) OR username+password
AAP_OAUTH_TOKEN=your_aap_oauth_token_here
# AAP_USERNAME=admin
# AAP_PASSWORD=your_password_here

# ─── Optional / Tuning ────────────────────────────────────────────────────────
AAP_VERIFY_SSL=true

# Server behavior
AAP_MCP_READ_ONLY_MODE=false
AAP_MCP_REQUIRE_CONFIRMATION=true
AAP_MCP_RATE_LIMIT_REQUESTS_PER_MINUTE=120
AAP_MCP_MAX_PAGE_SIZE=200
AAP_MCP_REQUEST_TIMEOUT_SECONDS=60

# Transport: streamable_http (remote) or stdio (local/Claude Desktop)
MCP_TRANSPORT=streamable_http
MCP_PORT=8000
MCP_HOST=0.0.0.0

# Audit logging (set to empty string to disable file logging)
AAP_MCP_AUDIT_LOG_FILE=/var/log/aap-mcp/audit.jsonl
